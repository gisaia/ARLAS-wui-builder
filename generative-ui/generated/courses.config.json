        "name": "courses"
      },
      "max_age_cache": 3600
    },
    "tagger": {
      "url": "http://localhost:9999/tagger",
      "collection": "courses"
    },
    "web": {
      "contributors": [
        {
          "type": "map",
          "identifier": "map_courses",
          "name": "Map courses",
          "icon": "map",
          "collection": "courses",
          "geo_query_field": "track.trail",
          "geo_query_op": "Intersects",
          "window_extent_geometry": "geometry_path",
          "margePanForLoad": 0,
          "margePanForTest": 0,
          "layers_sources": [
            {
              "id": "arlas_id:Trajectoires par type:trails_by_type",
              "name": "Trajectoires par type",
              "source": "feature-trails_by_type",
              "minzoom": 0,
              "maxzoom": 23,
              "maxfeatures": 5000,
              "render_mode": "wide",
              "returned_geometry": "track.trail",
              "include_fields": [
                "object.ship_type"
              ]
            },
            {
              "id": "arlas_id:Trajectoires par vitesse:trails_by_speed",
              "name": "Vitesse moyenne du parcours",
              "source": "feature-trails_by_speed",
              "minzoom": 0,
              "maxzoom": 23,
              "maxfeatures": 5000,
              "render_mode": "wide",
              "returned_geometry": "track.trail",
              "include_fields": [
                "track.dynamics.gps.speed_nd"
              ]
            },
            {
              "id": "arlas_id:Ports de depart:departures",
              "name": "Ports de départ",
              "source": "cluster-departure.location-Finest-tile-centroid-courses",
              "minzoom": 0,
              "maxzoom": 23,
              "agg_geo_field": "departure.location",
              "aggType": "tile",
              "granularity": "Finest",
              "minfeatures": 0,
              "aggregated_geometry": "centroid",
              "metrics": [
                {
                  "field": "",
                  "metric": "count",
                  "normalize": true
                }
              ]
            },
            {
              "id": "arlas_id:Ports d arrivee:arrivals",
              "name": "Ports d'arrivée",
              "source": "cluster-arrival.location-Finest-tile-centroid-courses",
              "minzoom": 0,
              "maxzoom": 23,
              "agg_geo_field": "arrival.location",
              "aggType": "tile",
              "granularity": "Finest",
              "minfeatures": 0,
              "aggregated_geometry": "centroid",
              "metrics": [
                {
                  "field": "",
                  "metric": "count",
                  "normalize": true
                }
              ]
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "timeline",
          "name": "Chronologie des parcours",
          "icon": "watch_later",
          "collection": "courses",
          "isOneDimension": false,
          "useUtc": true,
          "additionalCollections": [],
          "aggregationmodels": [
            {
              "type": "datehistogram",
              "field": "track.timestamps.center",
              "interval": {
                "value": 1,
                "unit": "hour"
              }
            }
          ]
        },
        {
          "type": "detailedhistogram",
          "identifier": "detailedTimeline",
          "name": "Chronologie détaillée",
          "icon": "watch_later",
          "collection": "courses",
          "annexedContributorId": "timeline",
          "isOneDimension": false,
          "useUtc": true,
          "numberOfBuckets": 50,
          "selectionExtentPercentage": 0.2,
          "additionalCollections": [],
          "aggregationmodels": [
            {
              "type": "datehistogram",
              "field": "track.timestamps.center"
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "speed_histogram",
          "name": "Distribution des vitesses",
          "title": "Distribution des vitesses",
          "icon": "speed",
          "collection": "courses",
          "isOneDimension": true,
          "useUtc": false,
          "additionalCollections": [],
          "aggregationmodels": [
            {
              "type": "histogram",
              "field": "track.dynamics.gps.speed_nd",
              "interval": {
                "value": 1
              }
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "straightness_histogram",
          "name": "Rectitude des trajectoires",
          "title": "Rectitude des parcours",
          "icon": "timeline",
          "collection": "courses",
          "isOneDimension": true,
          "useUtc": false,
          "numberOfBuckets": 20,
          "additionalCollections": [],
          "aggregationmodels": [
            {
              "type": "histogram",
              "field": "track.distance.gps.straightness"
            }
          ]
        },
        {
          "type": "tree",
          "identifier": "shiptype_tree",
          "name": "Types de navires",
          "title": "Parcours par type de navire",
          "icon": "directions_boat",
          "collection": "courses",
          "aggregationmodels": [
            {
              "type": "term",
              "field": "object.ship_type",
              "size": 12
            }
          ]
        },
        {
          "type": "tree",
          "identifier": "departure_port_tree",
          "name": "Ports de départ",
          "title": "Ports de départ",
          "icon": "logout",
          "collection": "courses",
          "aggregationmodels": [
            {
              "type": "term",
              "field": "departure.address.port",
              "size": 25
            }
          ]
        },
        {
          "type": "tree",
          "identifier": "arrival_port_tree",
          "name": "Ports d'arrivée",
          "title": "Ports d'arrivée",
          "icon": "login",
          "collection": "courses",
          "aggregationmodels": [
            {
              "type": "term",
              "field": "arrival.address.port",
              "size": 25
            }
          ]
        },
        {
          "type": "tree",
          "identifier": "top_vessels_tree",
          "name": "Navires les plus actifs",
          "title": "10 navires les plus actifs",
          "icon": "directions_boat",
          "collection": "courses",
          "aggregationmodels": [
            {
              "type": "term",
              "field": "object.name",
              "size": 10
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "distinct_vessels",
          "name": "Navires distincts",
          "title": "Nombre de navires distincts",
          "icon": "directions_boat",
          "collection": "courses",
          "function": "m[0]",
          "metrics": [
            {
              "field": "object.mmsi",
              "metric": "cardinality"
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "courses_per_vessel",
          "name": "Parcours par navire",
          "title": "Nombre moyen de parcours par navire, sur la période sélectionnée",
          "icon": "repeat",
          "collection": "courses",
          "function": "m[1] > 0 ? m[0] / m[1] : 0",
          "metrics": [
            {
              "field": null,
              "metric": "count"
            },
            {
              "field": "object.mmsi",
              "metric": "cardinality"
            }
          ]
        },
        {
          "type": "swimlane",
          "identifier": "courses-track.timestamps.center-time-interval-Count--6-hourobject.ship_type",
          "name": "Dispersion temporelle par type (pas de 6 h)",
          "icon": "view_week",
          "collection": "courses",
          "swimlanes": [
            {
              "id": 1,
              "name": "Dispersion temporelle par type",
              "xAxisField": "track.timestamps.center",
              "termField": "object.ship_type",
              "jsonpath": "$.count",
              "useUtc": true,
              "aggregationmodels": [
                {
                  "type": "term",
                  "field": "object.ship_type",
                  "size": 10
                },
                {
                  "type": "datehistogram",
                  "field": "track.timestamps.center",
                  "interval": {
                    "value": 6,
                    "unit": "hour"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "metricstable",
          "identifier": "shiptype_metricstable",
          "name": "Comparaison par type",
          "title": "Comparaison par type de navire : vitesse moyenne et rectitude moyenne",
          "icon": "table_chart",
          "collection": "courses",
          "numberOfBuckets": 12,
          "sort": {
            "collection": "courses",
            "on": "metric",
            "order": "desc",
            "metric": {
              "metric": "avg",
              "field": "track.dynamics.gps.speed_nd"
            }
          },
          "configuration": [
            {
              "collection": "courses",
              "termfield": "object.ship_type",
              "metrics": [
                {
                  "metric": "avg",
                  "field": "track.dynamics.gps.speed_nd"
                },
                {
                  "metric": "avg",
                  "field": "track.distance.gps.straightness"
                }
              ]
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "fleet_weighted_speed",
          "name": "Vitesse moyenne de la flotte",
          "title": "Vitesse moyenne de la flotte (pondérée par la durée)",
          "icon": "speed",
          "collection": "courses",
          "function": "m[1] > 0 ? m[0] / m[1] * 1.943844 : 0",
          "metrics": [
            {
              "field": "track.distance.gps.travelled_m",
              "metric": "sum"
            },
            {
              "field": "track.duration_s",
              "metric": "sum"
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "effective_navigation_time",
          "name": "Temps effectif de navigation",
          "title": "Temps effectif de navigation (hors pauses)",
          "icon": "timer",
          "collection": "courses",
          "function": "(m[0] - m[1]) / 3600",
          "metrics": [
            {
              "field": "track.duration_s",
              "metric": "sum"
            },
            {
              "field": "track.pauses.duration_s",
              "metric": "sum"
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "pause_share",
          "name": "Part du temps à l'arrêt",
          "title": "Part du temps de parcours passée à l'arrêt",
          "icon": "pause_circle",
          "collection": "courses",
          "function": "m[0] > 0 ? 100 * m[1] / m[0] : 0",
          "metrics": [
            {
              "field": "track.duration_s",
              "metric": "sum"
            },
            {
              "field": "track.pauses.duration_s",
              "metric": "sum"
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "effective_duration_per_course",
          "name": "Durée effective moyenne",
          "title": "Durée effective moyenne d'un parcours (hors pauses)",
          "icon": "schedule",
          "collection": "courses",
          "function": "m[2] > 0 ? (m[0] - m[1]) / m[2] / 3600 : 0",
          "metrics": [
            {
              "field": "track.duration_s",
              "metric": "sum"
            },
            {
              "field": "track.pauses.duration_s",
              "metric": "sum"
            },
            {
              "field": null,
              "metric": "count"
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "duration_histogram",
          "name": "Distribution des durées",
          "title": "Distribution des durées de parcours",
          "icon": "bar_chart",
          "collection": "courses",
          "isOneDimension": true,
          "useUtc": false,
          "additionalCollections": [],
          "aggregationmodels": [
            {
              "type": "histogram",
              "field": "track.duration_s",
              "interval": {
                "value": 3600
              }
            }
          ]
        },
