{
  "layers": [
    {
      "id": "arlas_id:Trajectoires des navires:courses_trajectories",
      "type": "line",
      "source": "feature-track.trail-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible",
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "object_ship_type"
          ],
          "Cargo",
          "#0077b6",
          "Tanker",
          "#d90429",
          "Passenger",
          "#7209b7",
          "Tug",
          "#f77f00",
          "Fishing",
          "#38b000",
          "Pleasure",
          "#00b4d8",
          "High Speed Craft",
          "#e63946",
          "#00b4d8"
        ],
        "line-width": 2.5,
        "line-opacity": 0.85
      },
      "metadata": {
        "collection": "courses",
        "collection-display-name": "Courses",
        "stroke": {
          "color": [
            "get",
            "object_ship_type_arlas__color"
          ],
          "width": 2.5,
          "opacity": 0.85
        },
        "is-scrollable-layer": false
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas-hover-courses_trajectories",
      "type": "line",
      "source": "feature-track.trail-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible",
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffea00",
        "line-width": 4.5,
        "line-opacity": 1
      },
      "metadata": {
        "collection": "courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas-select-courses_trajectories",
      "type": "line",
      "source": "feature-track.trail-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible",
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ff0055",
        "line-width": 5,
        "line-opacity": 1
      },
      "metadata": {
        "collection": "courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas_id:Positions des navires:courses_locations",
      "type": "circle",
      "source": "feature-track.location-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "circle-radius": 5,
        "circle-color": "#06d6a0",
        "circle-stroke-width": 1.5,
        "circle-stroke-color": "#ffffff",
        "circle-opacity": 0.9
      },
      "metadata": {
        "collection": "courses",
        "collection-display-name": "Courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas-hover-courses_locations",
      "type": "circle",
      "source": "feature-track.location-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "circle-radius": 8,
        "circle-color": "#ffea00",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      },
      "metadata": {
        "collection": "courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas-select-courses_locations",
      "type": "circle",
      "source": "feature-track.location-window-courses",
      "minzoom": 0,
      "maxzoom": 22,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "circle-radius": 8,
        "circle-color": "#ff0055",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      },
      "metadata": {
        "collection": "courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    },
    {
      "id": "arlas_id:Densite des trajets:courses_density",
      "type": "fill",
      "source": "cluster-track.location-Medium-h3-cell-courses",
      "minzoom": 0,
      "maxzoom": 15,
      "layout": {
        "visibility": "visible"
      },
      "paint": {
        "fill-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "get",
            "count"
          ],
          0,
          "rgba(65, 182, 196, 0.4)",
          10,
          "rgba(254, 178, 76, 0.6)",
          50,
          "rgba(227, 26, 28, 0.8)"
        ],
        "fill-outline-color": "rgba(255, 255, 255, 0.2)",
        "fill-opacity": 0.7
      },
      "metadata": {
        "collection": "courses",
        "collection-display-name": "Courses"
      },
      "filter": [
        "all",
        [
          "all"
        ]
      ]
    }
  ],
  "external-event-layers": [
    {
      "id": "arlas-hover-courses_trajectories",
      "on": "hover"
    },
    {
      "id": "arlas-select-courses_trajectories",
      "on": "select"
    },
    {
      "id": "arlas-hover-courses_locations",
      "on": "hover"
    },
    {
      "id": "arlas-select-courses_locations",
      "on": "select"
    }
  ]
}
