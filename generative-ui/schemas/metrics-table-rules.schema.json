{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Metrics Table Rules",
  "description": "JSON Schema capturing validation rules for metrics table contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "metricsTable" }
        }
      },
      "then": {
        "properties": {
          "filterOperator": {
            "type": "string",
            "enum": ["Eq", "Neq", "Gt", "Lt", "Gte", "Lte"],
            "description": "Filter operator for metrics table data filtering"
          },
          "useColorService": {
            "type": "boolean",
            "description": "Whether to use color service for metrics table"
          },
          "applyColorTo": {
            "type": "string",
            "enum": ["row", "cell"],
            "description": "Whether to apply color to row or cell in metrics table"
          },
          "headerDisplayMode": {
            "type": "string",
            "enum": ["full", "compact"],
            "description": "Display mode for metrics table header"
          },
          "normaliseBy": {
            "type": "string",
            "description": "Normalization method for metrics table values"
          },
          "selectWithCheckbox": {
            "type": "boolean",
            "description": "Whether to select rows with checkbox in metrics table"
          },
          "showRowField": {
            "type": "boolean",
            "description": "Whether to show row field in metrics table"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "metricsTable" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "metricsTable",
      "identifier": "metrictable123",
      "name": "Metrics Table View",
      "title": "Metrics Table View",
      "collection": "collection123",
      "icon": "show_charts",
      "filterOperator": "Eq",
      "useColorService": true,
      "applyColorTo": "row",
      "headerDisplayMode": "full",
      "normaliseBy": "percentage",
      "selectWithCheckbox": true,
      "showRowField": false
    }
  ]
}