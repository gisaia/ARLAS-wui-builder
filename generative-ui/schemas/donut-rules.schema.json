{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Donut Rules",
  "description": "JSON Schema capturing validation rules for donut contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "donut" }
        }
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for donut. Required field."
          },
          "customizedCssClass": {
            "type": "string",
            "description": "CSS class for donut customization"
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Opacity of donut chart (0.0-1.0)"
          },
          "multiselectable": {
            "type": "boolean",
            "description": "Whether multiple slices can be selected"
          },
          "keysToColors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of keys mapped to colors"
          },
          "colorsSaturationWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Weight for color saturation (0.0-1.0)"
          },
          "diameter": {
            "type": "integer",
            "minimum": 100,
            "maximum": 500,
            "description": "Diameter of donut in pixels"
          },
          "containerWidth": {
            "type": "integer",
            "minimum": 100,
            "description": "Container width for donut in pixels"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement for donut values"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "donut" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "donut",
      "identifier": "donut123",
      "name": "Donut Chart",
      "title": "Donut Chart",
      "collection": "collection123",
      "icon": "insert_chart",
      "id": "donut1",
      "opacity": 0.8,
      "multiselectable": false,
      "keysToColors": ["key1", "key2", "key3"],
      "colorsSaturationWeight": 0.5,
      "diameter": 300,
      "containerWidth": 400,
      "unit": "value"
    }
  ]
}