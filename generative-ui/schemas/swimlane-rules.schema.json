{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Swimlane Rules",
  "description": "JSON Schema capturing validation rules for swimlane contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "swimlane" }
        }
      },
      "then": {
        "properties": {
          "swimLaneLabelsWidth": {
            "type": "integer",
            "minimum": 0,
            "description": "Width of swimlane labels in pixels"
          },
          "swimlaneBorderRadius": {
            "type": "integer",
            "minimum": 0,
            "description": "Border radius for swimlane corners in pixels"
          },
          "swimlaneHeight": {
            "type": "integer",
            "minimum": 10,
            "description": "Height of swimlane in pixels"
          },
          "swimlaneMode": {
            "type": "string",
            "enum": ["default", "compact", "extended"],
            "description": "Mode of swimlane display"
          },
          "swimlane_representation": {
            "type": "string",
            "description": "Representation type for swimlane"
          },
          "swimlane_options": {
            "type": "object",
            "description": "Options for swimlane configuration"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "swimlane" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "swimlane",
      "identifier": "swimlane123",
      "name": "Swimlane View",
      "title": "Swimlane View",
      "collection": "collection123",
      "icon": "timeline",
      "swimLaneLabelsWidth": 100,
      "swimlaneBorderRadius": 5,
      "swimlaneHeight": 50,
      "swimlaneMode": "default",
      "swimlane_representation": "bar",
      "swimlane_options": {}
    }
  ]
}