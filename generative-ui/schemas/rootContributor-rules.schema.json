{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Root Contributor Rules",
  "description": "JSON Schema capturing validation rules for root contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "root" }
        }
      },
      "then": {
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Unique identifier for root contributor. Required field."
          },
          "name": {
            "type": "string",
            "description": "Name of root contributor. Required field."
          },
          "collection": {
            "type": "string",
            "description": "Collection name for root contributor"
          },
          "icon": {
            "type": "string",
            "description": "Icon name for root contributor"
          },
          "title": {
            "type": "string",
            "description": "Title of root contributor"
          },
          "aggregationmodels": {
            "type": "array",
            "items": { "type": "object" },
            "description": "Array of aggregation models for root contributor"
          }
        },
        "required": ["identifier", "name"]
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "root" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "root",
      "identifier": "root123",
      "name": "Root View",
      "title": "Root View",
      "collection": "collection123",
      "icon": "trending_up",
      "aggregationmodels": []
    }
  ]
}