{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Histogram Contributor Rules",
  "description": "JSON Schema capturing validation rules for histogram contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "histogram" }
        }
      },
      "then": {
        "properties": {
          "isOneDimension": {
            "type": "boolean",
            "description": "Whether the histogram is one-dimensional. Required field."
          },
          "useUtc": {
            "type": "boolean",
            "description": "Whether to use UTC timezone for histogram timestamps. Must be present."
          },
          "numberOfBuckets": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of buckets for the histogram. Required field."
          },
          "timeShortcuts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Time shortcuts for histogram (e.g., 'last_day', 'last_week')"
          },
          "yearShortcuts": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Year shortcuts for histogram (e.g., 'last_5_years')"
          },
          "jsonpath": {
            "type": "string",
            "description": "JSONPath expression for data extraction. Must match schema format."
          },
          "additionalCollections": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "Additional collections for histogram. Must be present."
          }
        },
        "required": ["isOneDimension", "useUtc", "numberOfBuckets", "additionalCollections"]
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "histogram" },
          "isOneDimension": { "const": true }
        }
      },
      "then": {
        "properties": {
          "jsonpath": {
            "type": "string",
            "pattern": "^\\$.+\\..+$",
            "description": "JSONPath must be present when histogram is one-dimensional"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "histogram" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "title": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "histogram",
      "identifier": "hist123",
      "name": "Histogram 1",
      "title": "Histogram 1",
      "collection": "collection123",
      "icon": "show_charts",
      "isOneDimension": true,
      "useUtc": true,
      "numberOfBuckets": 50,
      "timeShortcuts": ["last_day", "last_week", "last_month"],
      "yearShortcuts": ["last_5_years", "last_10_years"],
      "jsonpath": "$.metrics",
      "additionalCollections": ["collection_a", "collection_b"],
      "aggregationmodels": []
    }
  ]
}