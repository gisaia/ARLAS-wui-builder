{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Map Contributor Rules",
  "description": "JSON Schema capturing validation rules for map contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "map" }
        }
      },
      "then": {
        "properties": {
          "window_extent_geometry": {
            "type": "object",
            "description": "Window extent geometry for map contributor. Required for map type contributors.",
            "required": ["enabled", "boundsFieldName"]
          },
          "layers_sources": {
            "type": "array",
            "description": "Layer sources for the map contributor. Must be present for map type."
          },
          "geo_query_field": {
            "type": "string",
            "description": "Geo query field for map contributor"
          },
          "geo_query_op": {
            "type": "string",
            "description": "Geo query operator for map contributor"
          },
          "isFlat": {
            "type": "boolean",
            "description": "Whether to use flat projection for map"
          },
          "draw_precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Draw precision percentage for map (0-100)"
          },
          "data_mode": {
            "type": "string",
            "enum": ["static", "dynamic", "real-time"],
            "description": "Data mode for map contributor"
          },
          "simple_mode_accumulative": {
            "type": "boolean",
            "description": "Whether to use simple accumulative mode for map"
          },
          "search_sort": {
            "type": "string",
            "enum": ["asc", "desc", "none"],
            "description": "Search sort order for map"
          }
        },
        "required": ["window_extent_geometry", "layers_sources"]
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "map" },
          "window_extent_geometry": { "const": true }
        }
      },
      "then": {
        "properties": {
          "window_extent_geometry.enabled": {
            "const": true,
            "description": "Map extent is enabled when window_extent_geometry is present"
          },
          "window_extent_geometry.boundsFieldName": {
            "type": "string",
            "const": "",
            "description": "Bounds field name is required when extent is enabled"
          }
        }
      }
    },
    {
      "description": "Ensure generated config matches reference (exemple/config_real.json)",
      "allOf": [
        {
          "properties": {
            "type": { "const": "map" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "window_extent_geometry": {
                    "not": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "map",
      "identifier": "map123",
      "name": "Map View",
      "title": "Map View",
      "collection": "collection123",
      "icon": "map",
      "layers_sources": [
        {
          "name": "layer1",
          "type": "geojson",
          "url": "https://example.com/data.geojson"
        }
      ],
      "window_extent_geometry": {
        "enabled": true,
        "boundsFieldName": "extent"
      },
      "geo_query_field": "properties.name",
      "geo_query_op": "contains",
      "isFlat": false,
      "draw_precision": 50,
      "data_mode": "static",
      "simple_mode_accumulative": false,
      "search_sort": "asc",
      "network_fetching_level": "collection"
    }
  ]
}