{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "title": "Contributors Configuration",
    "description": "The Configuration of Contributors",
    "type": "object",
    "$id": "rootContributorConf.schema.json",
    "definitions": {
        "type": {
            "enum": [
                "analytics",
                "chipssearch",
                "detailedhistogram",
                "histogram",
                "map",
                "resultlist",
                "search",
                "swimlane",
                "topomap",
                "tree",
                "metric",
                "metricstable"
            ]
        },
        "identifier": {
            "description": "The unique identifier for a Contributor",
            "type": "string"
        },
        "linked_contributor_id": {
            "description": "The identifier of a contributor that is linked to this one",
            "type": "string"
        },
        "collection": {
            "description": "The unique collection for a Contributor",
            "type": "string"
        },
        "name": {
            "description": "The name of the Contributor",
            "type": "string"
        },
        "aggregationmodels": {
            "description": "List of aggregation, order matters",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "description": "Type of aggregation",
                        "enum": [
                            "datehistogram",
                            "geohash",
                            "histogram",
                            "term"
                        ]
                    },
                    "field": {
                        "description": "Field of aggregation",
                        "type": "string"
                    },
                    "interval": {
                        "description": "Interval of aggregation",
                        "type": "object",
                        "properties": {
                            "value": {
                                "description": "Value of interval",
                                "type": "integer"
                            },
                            "unit": {
                                "description": "Unit of interval",
                                "enum": [
                                    "year",
                                    "quarter",
                                    "month",
                                    "week",
                                    "day",
                                    "hour",
                                    "minute",
                                    "second"
                                ]
                            }
                        }
                    },
                    "fetch_geometry": {
                        "description": "How to retrieve geometry for term and geohash aggregation",
                        "type": "object",
                        "properties": {
                            "strategy:": {
                                "description": "Strategy to fetch geometry",
                                "enum": [
                                    "bbox",
                                    "centroid",
                                    "first",
                                    "last",
                                    "byDefault",
                                    "geohash"
                                ]
                            }
                        }
                    },
                    "size": {
                        "description": "Size of aggregation",
                        "type": "integer"
                    },
                    "order": {
                        "description": "Order of aggregation",
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ]
                    },
                    "on": {
                        "description": "Sort on count, result or field",
                        "type": "string",
                        "enum": [
                            "count",
                            "result",
                            "field"
                        ]
                    },
                    "metrics": {
                        "description": "List of metrics for aggregation",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "collect_field": {
                                    "type": "string"
                                },
                                "collect_fct": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "fetch_hits": {
                        "description": "Fetch hits configuration",
                        "type": "object",
                        "properties": {
                            "size": {
                                "type": "integer"
                            },
                            "include": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "required": [
                    "type",
                    "field"
                ]
            }
        },
        "cache_duration":{
            "description": "Duration of browser cache.",
            "type": "number"
        }
    },
    "properties": {
        "identifier": {
            "$ref": "#/definitions/identifier"
        },
        "name": {
            "$ref": "#/definitions/name"
        },
        "collection": {
            "$ref": "#/definitions/collection"
        },
        "icon": {
            "description": "Icon of the contributor, from Material Icons",
            "type": "string"
        },
        "title": {
            "description": "Title of contributor",
            "type": "string"
        },
        "aggregationmodels": {
            "$ref": "#/definitions/aggregationmodels"
        }
    },
    "required": [
        "type",
        "identifier",
        "name"
    ]
}
