{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Metric Rules",
  "description": "JSON Schema capturing validation rules for metric contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "metric" }
        }
      },
      "then": {
        "properties": {
          "customizedCssClass": {
            "type": "string",
            "description": "CSS class for metric customization"
          },
          "shortValue": {
            "type": "boolean",
            "description": "Whether to format numbers with compact representation"
          },
          "valuePrecision": {
            "type": "number",
            "description": "Number of decimal digits to display"
          },
          "beforeValue": {
            "type": "string",
            "description": "Text displayed before the value"
          },
          "afterValue": {
            "type": "string",
            "description": "Text displayed after the value"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "metric" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "metric",
      "identifier": "metric123",
      "name": "Metric View",
      "title": "Metric View",
      "collection": "collection123",
      "icon": "trending_up",
      "customizedCssClass": "metric-custom"
    }
  ]
}