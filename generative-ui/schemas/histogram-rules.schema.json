{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Histogram Rules",
  "description": "JSON Schema capturing validation rules for histogram contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "histogram" }
        }
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for histogram. Required field."
          },
          "dataType": {
            "type": "string",
            "description": "Data type for histogram (e.g., 'number', 'date')"
          },
          "dataUnit": {
            "type": "string",
            "description": "Unit of measurement for histogram values"
          },
          "xUnit": {
            "type": "string",
            "description": "X-axis unit for histogram"
          },
          "yUnit": {
            "type": "string",
            "description": "Y-axis unit for histogram"
          },
          "chartXLabel": {
            "type": "string",
            "description": "X-axis label for histogram chart"
          },
          "isHistogramSelectable": {
            "type": "boolean",
            "description": "Whether histogram is selectable in UI"
          },
          "multiselectable": {
            "type": "boolean",
            "description": "Whether multiple histogram items can be selected"
          },
          "displayOnlyIntervalsWithData": {
            "type": "boolean",
            "description": "Whether to display only intervals with data"
          },
          "applyOffsetOnAreaChart": {
            "type": "boolean",
            "description": "Whether to apply offset on area chart"
          },
          "topOffsetRemoveInterval": {
            "type": "integer",
            "minimum": 0,
            "description": "Top offset remove interval for histogram"
          },
          "leftOffsetRemoveInterval": {
            "type": "integer",
            "minimum": 0,
            "description": "Left offset remove interval for histogram"
          },
          "brushHandlesHeightWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Weight for brush handles height (0.0-1.0)"
          },
          "chartType": {
            "type": "string",
            "description": "Type of histogram chart"
          },
          "chartTitle": {
            "type": "string",
            "description": "Title of histogram chart"
          },
          "chartWidth": {
            "type": "integer",
            "minimum": 100,
            "description": "Width of histogram chart in pixels"
          },
          "chartHeight": {
            "type": "integer",
            "minimum": 100,
            "description": "Height of histogram chart in pixels"
          },
          "customizedCssClass": {
            "type": "string",
            "description": "CSS class for histogram customization"
          },
          "yAxisStartsFromZero": {
            "type": "boolean",
            "description": "Whether Y-axis starts from zero in histogram"
          },
          "showStripes": {
            "type": "boolean",
            "description": "Whether to show stripes on histogram"
          },
          "xAxisPosition": {
            "type": "string",
            "enum": ["bottom", "top", "left", "right"],
            "description": "Position of X-axis in histogram"
          },
          "descriptionPosition": {
            "type": "string",
            "description": "Position of description in histogram"
          },
          "xTicks": {
            "type": "boolean",
            "description": "Whether to show X-axis ticks in histogram"
          },
          "yTicks": {
            "type": "boolean",
            "description": "Whether to show Y-axis ticks in histogram"
          },
          "xLabels": {
            "type": "boolean",
            "description": "Whether to show X-axis labels in histogram"
          },
          "shortYLabels": {
            "type": "boolean",
            "description": "Whether to show short Y-axis labels in histogram"
          },
          "yLabels": {
            "type": "boolean",
            "description": "Whether to show Y-axis labels in histogram"
          },
          "showXTicks": {
            "type": "boolean",
            "description": "Whether to show X-axis ticks in histogram"
          },
          "showYTicks": {
            "type": "boolean",
            "description": "Whether to show Y-axis ticks in histogram"
          },
          "showXLabels": {
            "type": "boolean",
            "description": "Whether to show X-axis labels in histogram"
          },
          "showYLabels": {
            "type": "boolean",
            "description": "Whether to show Y-axis labels in histogram"
          },
          "showHorizontalLines": {
            "type": "boolean",
            "description": "Whether to show horizontal lines in histogram"
          },
          "paletteColors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of colors for histogram palette"
          },
          "ticksDateFormat": {
            "type": "string",
            "description": "Date format for histogram ticks"
          },
          "isSmoothedCurve": {
            "type": "boolean",
            "description": "Whether to show smoothed curve on histogram"
          },
          "barWeight": {
            "type": "integer",
            "minimum": 1,
            "description": "Weight of histogram bars"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "histogram" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "histogram",
      "identifier": "hist123",
      "name": "Histogram View",
      "title": "Histogram View",
      "collection": "collection123",
      "icon": "show_charts",
      "id": "hist-001",
      "dataType": "number",
      "dataUnit": "count",
      "xUnit": "time",
      "yUnit": "value",
      "chartXLabel": "Time",
      "isHistogramSelectable": true,
      "multiselectable": false,
      "displayOnlyIntervalsWithData": false,
      "applyOffsetOnAreaChart": false,
      "topOffsetRemoveInterval": 0,
      "leftOffsetRemoveInterval": 0,
      "brushHandlesHeightWeight": 0.5,
      "chartType": "area",
      "chartTitle": "Histogram",
      "chartWidth": 800,
      "chartHeight": 600,
      "customizedCssClass": "histogram-custom",
      "yAxisStartsFromZero": true,
      "showStripes": false,
      "xAxisPosition": "bottom",
      "descriptionPosition": "bottom",
      "xTicks": true,
      "yTicks": true,
      "xLabels": true,
      "shortYLabels": false,
      "yLabels": true,
      "showXTicks": true,
      "showYTicks": true,
      "showXLabels": true,
      "showYLabels": true,
      "showHorizontalLines": false,
      "paletteColors": ["#1f77b4", "#ff7f0e", "#2ca02c"],
      "ticksDateFormat": "YYYY-MM-DD",
      "isSmoothedCurve": false,
      "barWeight": 2
    }
  ]
}