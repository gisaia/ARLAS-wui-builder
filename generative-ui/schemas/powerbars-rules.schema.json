{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Powerbars Rules",
  "description": "JSON Schema capturing validation rules for powerbar contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "powerbars" }
        }
      },
      "then": {
        "properties": {
          "chartTitle": {
            "type": "string",
            "description": "Title of powerbar chart"
          },
          "powerbarTitle": {
            "type": "string",
            "description": "Title for individual powerbar"
          },
          "chartWidth": {
            "type": "integer",
            "minimum": 100,
            "description": "Width of powerbar chart in pixels"
          },
          "scrollable": {
            "type": "boolean",
            "description": "Whether powerbar chart is scrollable"
          },
          "useColorFromData": {
            "type": "boolean",
            "description": "Whether to use color from data for powerbars"
          },
          "customizedCssClass": {
            "type": "string",
            "description": "CSS class for powerbars customization"
          },
          "keysToColors": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Array of keys mapped to colors for powerbars"
          },
          "colorsSaturationWeight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Weight for color saturation (0.0-1.0) for powerbars"
          },
          "useColorService": {
            "type": "boolean",
            "description": "Whether to use color service for powerbars"
          },
          "displayFilter": {
            "type": "boolean",
            "description": "Whether to display filter for powerbars"
          },
          "unit": {
            "type": "string",
            "description": "Unit of measurement for powerbars values"
          },
          "filterOperator": {
            "type": "string",
            "enum": ["Eq", "Neq", "Gt", "Lt", "Gte", "Lte"],
            "description": "Filter operator for powerbars data filtering"
          },
          "groupSelections": {
            "type": "boolean",
            "description": "Whether to group selections for powerbars"
          },
          "selectWithCheckbox": {
            "type": "boolean",
            "description": "Whether to select items with checkbox in powerbars"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "powerbars" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "powerbars",
      "identifier": "powerbars123",
      "name": "Powerbars View",
      "title": "Powerbars View",
      "collection": "collection123",
      "icon": "show_charts",
      "chartTitle": "Powerbars",
      "powerbarTitle": "Powerbar",
      "chartWidth": 800,
      "scrollable": false,
      "useColorFromData": true,
      "customizedCssClass": "powerbars-custom",
      "keysToColors": ["key1", "key2", "key3"],
      "colorsSaturationWeight": 0.5,
      "useColorService": true,
      "displayFilter": true,
      "unit": "value",
      "filterOperator": "Eq",
      "groupSelections": false,
      "selectWithCheckbox": true
    }
  ]
}