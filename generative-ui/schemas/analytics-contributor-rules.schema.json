{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Analytics Contributor Rules",
  "description": "JSON Schema capturing validation rules for analytics contributors discovered in ARLAS WUI code generation patterns",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "analytics" }
        }
      },
      "then": {
        "properties": {
          "jsonpath": {
            "type": "string",
            "description": "JSONPath expression for analytics data extraction. Must be present for analytics type."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "analytics" },
          "jsonpath": { "const": true }
        }
      },
      "then": {
        "properties": {
          "jsonpath": {
            "pattern": "^\\$.+\\..+$",
            "description": "JSONPath must follow $.path.to.data format when present for analytics type"
          }
        }
      }
    },
    {
      "description": "Prevent extra properties not in schema from being generated",
      "allOf": [
        {
          "properties": {
            "type": { "const": "analytics" }
          },
          "not": {
            "anyOf": [
              {
                "properties": {
                  "charttype": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "properties": {
                  "icon": {
                    "not": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "examples": [
    {
      "type": "analytics",
      "identifier": "analytics123",
      "name": "Analytics View",
      "title": "Analytics View",
      "collection": "collection123",
      "icon": "insert_chart",
      "jsonpath": "$.data.metrics"
    }
  ]
}