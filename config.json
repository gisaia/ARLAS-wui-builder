{
  "arlas": {
    "server": {
      "url": "http://localhost:9999/arlas",
      "collection": {
        "name": "courses"
      },
      "max_age_cache": 3600
    },
    "tagger": {
      "url": "http://localhost:9999/tagger",
      "collection": "courses"
    },
    "web": {
      "contributors": [
        {
          "type": "map",
          "identifier": "map_courses",
          "name": "Map courses",
          "icon": "map",
          "collection": "courses",
          "geo_query_field": "track.location",
          "geo_query_op": "Intersects",
          "window_extent_geometry": "centroid_path",
          "margePanForLoad": 0,
          "margePanForTest": 0,
          "layers_sources": [
            {
              "id": "arlas_id:Trajectoires des navires:vessel_trails",
              "name": "Trajectoires des navires",
              "source": "feature-vessel_trails",
              "render_mode": "window",
              "returned_geometry": "track.trail"
            },
            {
              "id": "arlas_id:Positions des navires:vessel_locations",
              "name": "Positions regroupées",
              "source": "cluster-vessel_locations",
              "aggType": "tile",
              "granularity": "Fine",
              "aggregated_geometry": "bbox",
              "agg_geo_field": "track.location",
              "minfeatures": 5,
              "maxzoom": 12
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "timeline",
          "name": "Chronologie des navigations",
          "icon": "watch_later",
          "collection": "courses",
          "isOneDimension": true,
          "useUtc": true,
          "aggregationmodels": [
            {
              "type": "datehistogram",
              "field": "track.timestamps.center",
              "interval": {
                "value": 1,
                "unit": "day"
              }
            }
          ]
        },
        {
          "type": "detailedhistogram",
          "identifier": "detailedTimeline",
          "name": "Chronologie détaillée",
          "icon": "watch_later",
          "collection": "courses",
          "annexedContributorId": "timeline",
          "isOneDimension": true,
          "useUtc": true,
          "numberOfBuckets": 50,
          "selectionExtentPercentage": 0.2,
          "aggregationmodels": [
            {
              "type": "datehistogram",
              "field": "track.timestamps.center",
              "interval": {
                "value": 1,
                "unit": "hour"
              }
            }
          ]
        },
        {
          "type": "histogram",
          "identifier": "speed_histogram",
          "name": "Distribution des vitesses",
          "title": "Distribution des vitesses",
          "icon": "bar_chart",
          "collection": "courses",
          "isOneDimension": true,
          "useUtc": false,
          "numberOfBuckets": 25,
          "aggregationmodels": [
            {
              "type": "histogram",
              "field": "track.dynamics.gps.speed_nd",
              "interval": {
                "value": 2
              }
            }
          ]
        },
        {
          "type": "tree",
          "identifier": "shiptype_tree",
          "name": "Types de navires",
          "title": "Répartition par type de navire",
          "icon": "donut_large",
          "collection": "courses",
          "aggregationmodels": [
            {
              "type": "term",
              "field": "object.ship_type",
              "size": 15
            }
          ]
        },
        {
          "type": "swimlane",
          "identifier": "courses-track.timestamps.center-time-interval-Count--1-dayobject.ship_type",
          "name": "Dispersion temporelle par type de navire",
          "icon": "view_week",
          "collection": "courses",
          "swimlanes": [
            {
              "id": 1,
              "name": "Dispersion temporelle par type de navire",
              "xAxisField": "track.timestamps.center",
              "termField": "object.ship_type",
              "jsonpath": "$.count",
              "useUtc": true,
              "aggregationmodels": [
                {
                  "type": "term",
                  "field": "object.ship_type",
                  "size": 10
                },
                {
                  "type": "datehistogram",
                  "field": "track.timestamps.center",
                  "interval": {
                    "value": 1,
                    "unit": "day"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "metric",
          "identifier": "avg_duration_metric",
          "name": "Durée moyenne de navigation",
          "title": "Durée moyenne d'un parcours (heures)",
          "icon": "timer",
          "collection": "courses",
          "function": "m[0] / 3600",
          "metrics": [
            {
              "field": "track.duration_s",
              "metric": "avg"
            }
          ]
        },
        {
          "type": "search",
          "identifier": "search_vessel",
          "name": "Recherche de navire",
          "icon": "search",
          "collection": "courses",
          "search_field": "object.name",
          "autocomplete_field": "object.name",
          "autocomplete_size": 10
        },
        {
          "type": "resultlist",
          "identifier": "resultlist_courses",
          "name": "Liste des parcours",
          "icon": "table_chart",
          "collection": "courses",
          "options": {
            "showName": false
          },
          "cardViewProperties": [],
          "search_size": 50,
          "max_pages": 3,
          "fieldsConfiguration": {
            "idFieldName": "track.id",
            "titleFieldNames": [
              {
                "fieldPath": "object.name",
                "process": ""
              }
            ],
            "tooltipFieldNames": [
              {
                "fieldPath": "object.ship_type",
                "process": ""
              }
            ],
            "iconColorFieldName": "object.ship_type",
            "icon": "fiber_manual_record",
            "urlImageTemplates": []
          },
          "columns": [
            {
              "columnName": "Nom du navire",
              "fieldName": "object.name",
              "dataType": "keyword",
              "process": "",
              "sort": ""
            },
            {
              "columnName": "Type de navire",
              "fieldName": "object.ship_type",
              "dataType": "keyword",
              "process": "",
              "sort": ""
            },
            {
              "columnName": "Vitesse moyenne (nd)",
              "fieldName": "track.dynamics.gps.speed_nd",
              "dataType": "DOUBLE",
              "process": "",
              "sort": ""
            },
            {
              "columnName": "Durée (s)",
              "fieldName": "track.duration_s",
              "dataType": "LONG",
              "process": "",
              "sort": ""
            },
            {
              "columnName": "Distance (m)",
              "fieldName": "track.distance.gps.travelled_m",
              "dataType": "LONG",
              "process": "",
              "sort": ""
            }
          ],
          "details": [
            {
              "name": "Caractéristiques du parcours",
              "order": 1,
              "fields": [
                {
                  "path": "track.id",
                  "label": "Identifiant",
                  "process": ""
                },
                {
                  "path": "track.duration_s",
                  "label": "Durée (secondes)",
                  "process": ""
                },
                {
                  "path": "track.dynamics.gps.speed_nd",
                  "label": "Vitesse (nœuds)",
                  "process": ""
                },
                {
                  "path": "track.distance.gps.travelled_m",
                  "label": "Distance parcourue (m)",
                  "process": ""
                }
              ]
            }
          ]
        }
      ],
      "components": {
        "mapgl": {
          "allowMapExtend": true,
          "nbVerticesLimit": 100,
          "input": {
            "margePanForLoad": 0,
            "margePanForTest": 0,
            "initZoom": 4,
            "initCenter": [
              -4,
              48
            ],
            "displayScale": true,
            "displayCurrentCoordinates": true,
            "enableGlobe": true,
            "defaultBasemapStyle": {
              "name": "Positron",
              "styleFile": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
            },
            "basemapStyles": [
              {
                "name": "Positron",
                "styleFile": "https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
              }
            ],
            "mapLayers": {
              "layers": [],
              "events": {
                "onHover": [
                  "arlas-hover-trails"
                ],
                "emitOnClick": [
                  "arlas_id:Trajectoires des navires:vessel_trails"
                ],
                "zoomOnClick": [
                  "arlas_id:Positions des navires:vessel_locations"
                ]
              },
              "externalEventLayers": []
            },
            "visualisations_sets": [
              {
                "name": "Trajectoires & Positions",
                "layers": [
                  "arlas_id:Trajectoires des navires:vessel_trails",
                  "arlas_id:Positions des navires:vessel_locations"
                ],
                "enabled": true
              }
            ]
          }
        },
        "timeline": {
          "contributorId": "timeline",
          "dateFormat": "%d/%m/%Y %H:%M",
          "input": {
            "id": "timeline_chart",
            "chartTitle": "Chronologie des navigations",
            "chartType": "bars",
            "ticksDateFormat": "%d/%m/%Y %H:%M",
            "valuesDateFormat": "%d/%m/%Y %H:%M"
          }
        },
        "detailedTimeline": {
          "contributorId": "detailedTimeline",
          "dateFormat": "%d/%m/%Y %H:%M",
          "input": {
            "id": "detailed_timeline_chart",
            "chartTitle": "Chronologie détaillée",
            "chartType": "bars",
            "ticksDateFormat": "%d/%m/%Y %H:%M",
            "valuesDateFormat": "%d/%m/%Y %H:%M"
          }
        },
        "resultlists": [
          {
            "componentType": "resultlist",
            "contributorId": "resultlist_courses",
            "uuid": "resultlist_courses_uuid",
            "input": {
              "id": "resultlist_courses_input",
              "options": {
                "showName": true,
                "showIcon": true
              }
            }
          }
        ]
      },
      "analytics": [
        {
          "groupId": "group_kpi",
          "title": "Indicateurs Clés & Répartition",
          "tab": "Indicateurs",
          "icon": "insights",
          "components": [
            {
              "contributorId": "avg_duration_metric",
              "componentType": "metric",
              "title": "Durée moyenne d'un parcours (heures)",
              "uuid": "metric_duration_uuid",
              "input": {
                "id": "avg_duration_metric",
                "afterValue": " h",
                "valuePrecision": 1,
                "customizedCssClass": "metric-custom"
              }
            },
            {
              "contributorId": "shiptype_tree",
              "componentType": "donut",
              "title": "Types de navires",
              "uuid": "donut_shiptype_uuid",
              "input": {
                "id": "donut_shiptype_input",
                "diameter": 180,
                "containerWidth": 260
              }
            }
          ]
        },
        {
          "groupId": "group_speeds",
          "title": "Comparaison des Vitesses (Nœuds)",
          "tab": "Indicateurs",
          "icon": "speed",
          "components": [
            {
              "contributorId": "speed_histogram",
              "componentType": "histogram",
              "title": "Distribution des vitesses (nœuds)",
              "uuid": "hist_speed_uuid",
              "input": {
                "id": "speed_histogram",
                "chartTitle": "Distribution des vitesses (nœuds)",
                "dataType": "numeric",
                "chartType": "bars",
                "chartWidth": 445,
                "chartHeight": 120,
                "barWeight": 0.8,
                "xUnit": "nd",
                "chartYLabel": "Nombre de parcours",
                "yAxisStartsFromZero": true
              }
            }
          ]
        },
        {
          "groupId": "group_dispersion",
          "title": "Dispersion Temporelle par Type de Navire",
          "tab": "Dispersion",
          "icon": "timeline",
          "components": [
            {
              "contributorId": "courses-track.timestamps.center-time-interval-Count--1-dayobject.ship_type",
              "componentType": "swimlane",
              "title": "Dispersion chronologique des navires",
              "uuid": "swimlane_shiptype_uuid",
              "input": {
                "id": "courses-track.timestamps.center-time-interval-Count--1-dayobject.ship_type",
                "dataType": "time",
                "chartType": "bars",
                "chartWidth": 445,
                "chartHeight": 120,
                "barWeight": 0.8,
                "chartTitle": "Dispersion chronologique des navires",
                "customizedCssClass": "arlas-swimlane",
                "swimlane_representation": "global",
                "swimlane_options": {},
                "swimlaneMode": "fixedHeight",
                "swimlaneHeight": 28,
                "swimLaneLabelsWidth": 120
              }
            }
          ]
        },
        {
          "groupId": "group_results",
          "title": "Trajectoires et Données Détaillées",
          "tab": "Données",
          "icon": "table_chart",
          "components": [
            {
              "contributorId": "resultlist_courses",
              "componentType": "resultlist",
              "title": "Liste détaillée des parcours",
              "uuid": "resultlist_courses_analytics_uuid",
              "input": {
                "id": "resultlist_courses_input",
                "options": {
                  "showName": true,
                  "showIcon": true
                }
              }
            }
          ]
        }
      ],
      "options": {
        "drag_items": true,
        "zoom_to_strategy": "centroid",
        "indicators": false
      }
    }
  },
  "arlas-wui": {
    "web": {
      "app": {
        "name": "Observatoire Maritime : Vitesses, Trajectoires et Dispersion",
        "components": {
          "chipssearch": {
            "name": "Rechercher un navire...",
            "icon": "search"
          }
        },
        "units": [
          {
            "collection": "courses",
            "unit": "parcours",
            "ignored": false
          }
        ]
      }
    }
  },
  "extraConfigs": [
    {
      "configPath": "config.map.json",
      "replacedAttribute": "arlas.web.components.mapgl.input.mapLayers.layers",
      "replacer": "layers"
    },
    {
      "configPath": "config.map.json",
      "replacedAttribute": "arlas.web.components.mapgl.input.mapLayers.externalEventLayers",
      "replacer": "external-event-layers"
    }
  ]
}